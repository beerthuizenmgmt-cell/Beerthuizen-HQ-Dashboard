// BHMGMT HQ — datamodel
//
// Statuswaarden en categorieën sluiten aan op het bestaande domeinmodel van
// ~/.elara-reader (src/types.ts), zodat snapshots van de reader zonder
// vertaalslag binnenkomen. De enums zijn een superset: de reader gebruikt
// alleen de waarden die hij zelf kent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Basis
// ============================================================

enum UserRole {
  /// Enriqueo: alles, inclusief sleutels, budget en goedkeuringen.
  owner
  /// Dagelijkse kantooromgeving, zonder instellingen en zonder geldzaken.
  member
}

/// Wie heeft wat gedaan. Bewust apart van de activiteitenfeed: die gaat over
/// wat de agents doen, dit gaat over wat mensen doen.
model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Naam op het moment van handelen, zodat de regel leesbaar blijft als een
  /// account later wordt hernoemd of verwijderd.
  userName String
  userRole UserRole

  /// login | logout | task_create | approval_decide | agent_update | …
  action String
  detail String?

  targetType String?
  targetId   String?

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(member)
  createdAt    DateTime @default(now())

  createdTasks     Task[]         @relation("TaskCreatedByUser")
  taskUpdates      TaskUpdate[]
  messages         Message[]
  decidedAdvice    AdAdvice[]
  decidedApprovals Approval[]
  auditLogs        AuditLog[]
  portalRequests   PortalRequest[]
}

enum AgentStatus {
  active
  idle
  error
  offline
  paused
}

/// Categorieën uit het bestaande reader-model, aangevuld met bizdev.
enum AgentCategory {
  content
  marketing
  ads
  analyse
  ops
  research
  bizdev
  finance
  other
}

enum AdapterType {
  /// Agent die dit dashboard zelf draait op een taalmodel.
  builtin
  openclaw_gateway
  telegram
  reader_ingest
  manual
}

model Agent {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  role        String
  description String?
  emoji       String?
  color       String?
  category    AgentCategory @default(other)

  /// Het gezicht van de agent. Een URL of een data-URI van een geüpload beeld.
  /// Valt terug op de emoji en daarna op initialen, zodat er altijd iets staat.
  avatarUrl String?

  /// De Head of Operations stuurt de andere agents aan en is de enige die
  /// rechtstreeks met Enriqueo schakelt via Telegram.
  isChief Boolean @default(false)

  /// Wie deze agent is en waar hij op let. Wordt samen met de bedrijfscontext
  /// het systeemprompt. Leeg betekent: gebruik het standaardprofiel uit de seed.
  systemPrompt String?

  /// Werkinstructies: hoe deze agent zijn werk doet, in zijn eigen woorden
  /// opgeschreven door Enriqueo. Losstaand van het geheugen — dat is voor
  /// blijvende kernregels, dit is de handleiding bij de functie.
  ///
  /// Gaat integraal mee in het systeemprompt, na het functieprofiel.
  playbook String?

  /// Welk model deze agent draait. Leeg = het standaardmodel uit de
  /// instellingen. Bewust per agent instelbaar: zwaar denkwerk verdient een
  /// ander model dan repetitief werk.
  modelId String?

  /// Hoe ver deze agent zelfstandig mag gaan voordat hij goedkeuring vraagt.
  /// Externe, financiële en reputatiegevoelige acties vragen altijd akkoord.
  maxToolCalls Int @default(6)

  status      AgentStatus @default(offline)
  statusText  String?
  model       String?
  channels    String[]    @default([])
  progressPct Int?

  adapterType AdapterType @default(manual)
  /// Verbindingsgegevens. Geheimen zitten hierin versleuteld (AES-256-GCM)
  /// en verlaten de server nooit — zie src/lib/crypto.ts.
  adapterConfig Json?

  /// Waarmee deze agent zichzelf identificeert als hij terugpraat, via
  /// /api/agents/[id]/reply of de Telegram-webhook. Eén token per agent, zodat
  /// je hem kunt intrekken zonder de rest te raken.
  inboundToken String? @unique

  lastActiveAt   DateTime?
  lastCheckedAt  DateTime?
  lastError      String?
  paused         Boolean   @default(false)
  sortOrder      Int       @default(0)

  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]
  tasks          Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreatedByAgent")
  taskUpdates    TaskUpdate[]
  messagesFrom   Message[]       @relation("MessageFromAgent")
  messagesTo     Message[]       @relation("MessageToAgent")
  dmChannel      Channel?
  standupEntries StandupEntry[]
  questions      MeetingQuestion[]
  advice         AdAdvice[]
  costEntries    CostEntry[]
  notifications  Notification[]
  approvals      Approval[]
  runs           AgentRun[]
  valueEntries   ValueEntry[]
  watches        AgentWatch[]
  insights       AgentInsight[]
  tools          AgentTool[]
  memories       AgentMemory[]
  research       ResearchEntry[]

  @@index([category])
  @@index([status])
}

/// Een OpenClaw-installatie die via de reader outbound naar dit dashboard
/// pusht. Auth: `Bearer <publicId>:<apiKey>`.
model Instance {
  id            String    @id @default(cuid())
  publicId      String    @unique
  name          String
  apiKeyHash    String
  readerVersion String?
  uptimeSeconds Int?
  lastHeartbeatAt DateTime?
  lastSnapshotAt  DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  agents         Agent[]
  skills         Skill[]
  models         ModelInfo[]
  activityEvents ActivityEvent[]
}

enum ActivityLevel {
  info
  warn
  error
  success
}

model ActivityEvent {
  id         String        @id @default(cuid())
  occurredAt DateTime
  kind       String
  level      ActivityLevel @default(info)
  message    String
  payload    Json?
  createdAt  DateTime      @default(now())

  agentId    String?
  agent      Agent?    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  instanceId String?
  instance   Instance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([occurredAt(sort: Desc)])
  @@index([agentId, occurredAt(sort: Desc)])
}

model Skill {
  id           String  @id @default(cuid())
  key          String
  name         String
  description  String  @default("")
  installed    Boolean @default(false)
  slashCommand String?
  icon         String?
  category     String?

  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, key])
}

model ModelInfo {
  id            String  @id @default(cuid())
  modelId       String
  provider      String
  online        Boolean @default(true)
  contextWindow Int?

  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, modelId])
}

// ============================================================
// Werk
// ============================================================

enum TaskStatus {
  inbox
  assigned
  in_progress
  blocked
  review
  done
  cancelled
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum ActorType {
  user
  agent
  system
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(inbox)
  priority    TaskPriority @default(normal)

  agentId String?
  agent   Agent?  @relation("TaskAssignee", fields: [agentId], references: [id], onDelete: SetNull)

  /// Bij welk project deze taak hoort, als hij ergens uit voortkomt.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdByUserId  String?
  createdByUser    User?   @relation("TaskCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByAgentId String?
  createdByAgent   Agent?  @relation("TaskCreatedByAgent", fields: [createdByAgentId], references: [id], onDelete: SetNull)

  /// Waar de taak vandaan komt: handmatig, ochtendoverleg, ads-advies, agent.
  source      String   @default("manual")
  dueAt       DateTime?
  result      String?
  dispatchedAt DateTime?
  completedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updates      TaskUpdate[]
  advice       AdAdvice[]
  approvals    Approval[]
  agentRuns    AgentRun[]
  valueEntries ValueEntry[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([agentId, status])
}

model TaskUpdate {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorType   ActorType
  authorUserId String?
  authorUser   User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAgentId String?
  authorAgent  Agent?    @relation(fields: [authorAgentId], references: [id], onDelete: SetNull)

  /// comment | status | result | dispatch | error
  kind      String   @default("comment")
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

// ============================================================
// Communicatie
// ============================================================

enum ChannelKind {
  team
  dm
}

model Channel {
  id      String      @id @default(cuid())
  key     String      @unique
  name    String
  purpose String?
  kind    ChannelKind @default(team)

  /// Gevuld voor DM-kanalen: het gesprek met één specifieke agent.
  agentId String? @unique
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  messages Message[]
}

enum MessageDelivery {
  pending
  sent
  delivered
  failed
  local
}

model Message {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  fromType    ActorType
  fromUserId  String?
  fromUser    User?     @relation(fields: [fromUserId], references: [id], onDelete: SetNull)
  fromAgentId String?
  fromAgent   Agent?    @relation("MessageFromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)

  /// Gericht aan één agent — ook gebruikt voor agent-naar-agent verkeer,
  /// dat altijd in een kanaal zichtbaar blijft.
  toAgentId String?
  toAgent   Agent?  @relation("MessageToAgent", fields: [toAgentId], references: [id], onDelete: SetNull)

  body     String
  mentions String[] @default([])

  delivery      MessageDelivery @default(local)
  deliveryError String?
  createdAt     DateTime        @default(now())

  @@index([channelId, createdAt])
}

// ============================================================
// Ochtendoverleg
// ============================================================

enum MeetingStatus {
  scheduled
  collecting
  ready
  closed
}

model Meeting {
  id     String        @id @default(cuid())
  /// Kalenderdag van het overleg (Europe/Amsterdam), op middernacht UTC gezet.
  date   DateTime      @unique
  status MeetingStatus @default(scheduled)

  summaryMd String?
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  /// De ochtendcall: wanneer je erin sprong en wanneer je hem afsloot.
  callStartedAt DateTime?
  callEndedAt   DateTime?

  entries   StandupEntry[]
  questions MeetingQuestion[]
}

/// Een vraag die een agent aan jou stelt tijdens het ochtendoverleg. In de call
/// werk je deze wachtrij af; je antwoord gaat terug naar de agent die hem stelde.
model MeetingQuestion {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  body   String
  answer String?

  answeredAt DateTime?
  skippedAt  DateTime?
  /// Of je antwoord ook echt bij de agent is afgeleverd.
  deliveredAt   DateTime?
  deliveryError String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([meetingId, sortOrder])
}

model StandupEntry {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  yesterday String?
  today     String?
  blockers  String?
  /// Wat de agent aan jou wil vragen — wordt opgesplitst in MeetingQuestion's.
  questions String?
  rawReply  String?

  requestedAt DateTime  @default(now())
  receivedAt  DateTime?
  error       String?

  @@unique([meetingId, agentId])
}

// ============================================================
// Advertenties (Meta)
// ============================================================

model AdAccount {
  id         String   @id @default(cuid())
  platform   String   @default("meta")
  externalId String
  name       String
  currency   String   @default("EUR")
  createdAt  DateTime @default(now())
  lastSyncAt DateTime?

  campaigns AdCampaign[]

  @@unique([platform, externalId])
}

model AdCampaign {
  id         String    @id @default(cuid())
  accountId  String
  account    AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  externalId  String
  name        String
  objective   String?
  status      String? // ACTIVE, PAUSED, ...
  dailyBudget Float?
  startedAt   DateTime?

  /// De grenswaarden waartegen deze campagne beoordeeld wordt. Bewust per
  /// campagne en niet één universele norm: een awarenesscampagne op CPM
  /// afrekenen zoals een leadcampagne op CPA levert een verkeerd oordeel.
  ///
  /// Vrije vorm, want welke maatstaf telt hangt van het doel af. Bijvoorbeeld
  /// { "cpaEur": 27, "ctr": 0.012, "roas": 3.5 }.
  benchmarks Json?
  /// Waar die grenswaarden vandaan komen: eigen historie, platformgemiddelde,
  /// afspraak met de klant. Zonder herkomst is een benchmark een gok.
  benchmarkSource String?

  creatives AdCreative[]

  @@unique([accountId, externalId])
}

model AdCreative {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  externalId String
  name       String
  /// video | image | carousel | collection | reel | story
  format     String?
  placement  String?
  /// Creatieve hoek of hook, zodat we kunnen zien wat het beste werkt.
  angle        String?
  thumbnailUrl String?

  @@unique([campaignId, externalId])
}

enum MetricScope {
  account
  campaign
  creative
}

/// Dagcijfers op één van drie niveaus. Eén tabel met scope houdt de
/// vergelijkingen tussen niveaus simpel.
model AdMetric {
  id      String      @id @default(cuid())
  date    DateTime
  scope   MetricScope
  scopeId String

  spend       Float @default(0)
  impressions Int   @default(0)
  reach       Int   @default(0)
  clicks      Int   @default(0)
  conversions Int   @default(0)
  revenue     Float @default(0)
  videoViews  Int   @default(0)
  engagements Int   @default(0)

  @@unique([date, scope, scopeId])
  @@index([scope, scopeId, date])
}

enum AdviceStatus {
  open
  accepted
  rejected
  done
}

/// Advies van een agent over de advertenties — dit is wat het dashboard
/// bruikbaar maakt in plaats van alleen mooi.
model AdAdvice {
  id      String @id @default(cuid())
  agentId String?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  title          String
  bodyMd         String
  recommendation String?
  /// account | campaign | creative | format
  targetType     String?
  targetId       String?
  /// Bijvoorbeeld "ROAS +0,4" of "€120/maand besparing".
  expectedImpact String?
  severity       ActivityLevel @default(info)

  status         AdviceStatus @default(open)
  linkedTaskId   String?
  linkedTask     Task?        @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decidedByUserId String?
  decidedByUser  User?        @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
}

// ============================================================
// Overig
// ============================================================

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  failed
}

/// Alles wat naar buiten gaat, geld kost of de reputatie raakt komt hier eerst
/// langs. De agent bereidt het volledig voor; Enriqueo beslist.
model Approval {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// email_send | external_message | budget | publish | system_change | other
  kind    String
  title   String
  /// Waarom dit nodig is, in gewone taal.
  summary String
  /// De volledig voorbereide actie: ontvanger, onderwerp, tekst, bedrag.
  payload Json

  status         ApprovalStatus @default(pending)
  decisionNote   String?
  decidedAt      DateTime?
  decidedByUserId String?
  decidedByUser  User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  executedAt DateTime?
  error      String?

  linkedTaskId String?
  linkedTask   Task?   @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)

  /// Gaat dit verzoek over een factuur, dan hangt het eraan. Zo zie je bij de
  /// factuur zelf welke stap er op jouw akkoord wacht.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
}

/// Eén keer nadenken door een agent: wat er binnenkwam, welk model het deed,
/// wat het kostte en wat eruit kwam. Nodig om te zien waar je geld heen gaat en
/// om te achterhalen waarom een agent iets deed.
model AgentRun {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// task | standup | message | chief_cycle | call | manual | watch
  trigger String
  /// Waarom deze agent wakker werd. Bij event-driven activering staat hier wat
  /// er precies veranderd was.
  reason String?
  model   String
  /// Welke aanbieder het model draaide — nodig om kosten per provider te
  /// kunnen splitsen zodra er meer dan één in gebruik is.
  provider String @default("openrouter")

  /// Waar deze denkbeurt bij hoorde, zodat kosten per taak toe te rekenen zijn.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  input     String
  output    String?
  toolCalls Json?

  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costEur          Float @default(0)
  /// Of de kosten echt bekend zijn. Zonder tariefinformatie blijft dit false en
  /// tellen we de run niet mee als een bedrag — liever een gat dan een gok.
  costKnown  Boolean @default(false)
  durationMs Int     @default(0)

  ok    Boolean @default(true)
  error String?

  createdAt DateTime @default(now())

  @@index([agentId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Tarieven per model, opgehaald bij de aanbieder. Model- en
/// provideronafhankelijk: komt er een nieuwe aanbieder bij, dan komen zijn
/// tarieven hier binnen en telt de kostenberekening vanzelf mee.
model ModelPrice {
  id       String @id @default(cuid())
  provider String
  modelId  String

  /// Prijs in euro per miljoen tokens.
  promptPerMillion     Float
  completionPerMillion Float

  updatedAt DateTime @updatedAt

  @@unique([provider, modelId])
}

enum ValueKind {
  hours_saved
  revenue_opportunity
  campaign_supported
  task_automated
}

enum ValueSource {
  /// Ingeschat door een agent — telt pas mee zodra Enriqueo het bevestigt.
  agent_estimate
  /// Door Enriqueo zelf ingevoerd of bevestigd.
  user_entered
}

/// De waardekant tegenover de kosten. Bewust streng: een agent mag een
/// besparing vóórstellen, maar pas een bevestigde regel telt mee in het
/// eindbedrag. Zo staat er nooit een verzonnen besparing in je cijfers.
model ValueEntry {
  id   String    @id @default(cuid())
  date DateTime
  kind ValueKind

  /// Uren bij hours_saved, euro's bij revenue_opportunity, aantal bij de rest.
  amount Float
  note   String

  source      ValueSource
  confirmedAt DateTime?

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  taskId  String?
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
  @@index([kind, confirmedAt])
}

/// Een koppeling die aan één specifieke agent hangt. Bewust per agent: de
/// Creative Director heeft Canva nodig, de Analytics Manager niet. Nieuwe
/// tooltypes komen uit de catalogus in src/lib/ai/toolkit.ts, zodat er niets
/// herbouwd hoeft te worden als er een systeem bijkomt.
model AgentTool {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Sleutel uit de catalogus, bijvoorbeeld canva of custom_webhook.
  toolKey String
  /// Eigen naam, handig als je twee koppelingen van hetzelfde type hebt.
  label   String?

  /// Instellingen van deze koppeling. Geheimen staan hierin versleuteld.
  config Json?

  enabled Boolean @default(true)

  /// Wat deze agent met deze tool mag. Bewust per koppeling en niet per tool:
  /// dezelfde Canva mag voor de Creative Director schrijven en voor Analytics
  /// alleen leesbaar zijn.
  ///
  /// lezen       — ophalen en bekijken, verandert niets
  /// voorstellen — mag iets klaarzetten, maar het gaat pas door na akkoord
  /// schrijven   — mag zelfstandig wijzigen binnen die tool
  permission ToolPermission @default(lezen)

  /// Uitkomst van de laatste verbindingstest.
  lastCheckedAt DateTime?
  lastError     String?

  /// Wanneer een agent deze tool voor het laatst echt gebruikte. Laat zien wat
  /// leeft en wat er alleen maar bij staat.
  lastUsedAt DateTime?
  useCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, toolKey])
  @@index([agentId])
}

enum ToolPermission {
  lezen
  voorstellen
  schrijven
}

/// Wat er op tool-niveau geldt, los van wie hem gebruikt.
///
/// Een tool kan aan drie agents hangen maar één abonnement hebben, één
/// API-status en één maandbedrag. Dat hoort hier, niet drie keer in AgentTool.
model ToolIntegration {
  id      String @id @default(cuid())
  toolKey String @unique

  /// Of deze tool überhaupt in gebruik is bij Beerthuizen Management. Staat hij
  /// uit, dan kan geen enkele agent hem koppelen.
  enabled Boolean @default(true)

  /// Wat jij per maand voor dit platform betaalt. Handmatig ingevoerd — dit is
  /// abonnementsgeld dat nergens automatisch uit af te leiden valt. Leeg
  /// betekent onbekend, nooit nul.
  monthlyCostEur Float?

  /// Vrije aantekening: welk account, welk abonnement, wat er nog moet.
  notes String?

  /// Laatste keer dat de verbinding met succes getest is.
  lastTestAt DateTime?
  lastTestOk Boolean?
  lastTestError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Een onderwerp dat een agent in de gaten houdt. De kern van het
/// event-driven model: zolang de vingerafdruk van de data niet verandert,
/// wordt de agent niet wakker gemaakt en kost hij dus niets.
model AgentWatch {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Welke probe de data samenvat: tasks | ad_metrics | ad_campaigns |
  /// activity | approvals | messages | manual_signal
  probe String
  key   String @unique
  label String

  /// Vingerafdruk van de data zoals die nu is.
  dataHash String?
  /// Loopt op bij elke gedetecteerde wijziging — leest makkelijker dan een hash.
  dataVersion      Int       @default(0)
  lastDataChangeAt DateTime?

  /// Vingerafdruk waarop de laatste analyse is gedaan. Gelijk aan dataHash
  /// betekent: de agent heeft deze stand al bekeken.
  analyzedHash   String?
  lastAnalyzedAt DateTime?

  /// Rem tegen te vaak draaien, ook als er telkens kleine wijzigingen zijn.
  minIntervalMinutes Int       @default(60)
  nextEligibleAt     DateTime?

  /// Waarom de agent de laatste keer wakker werd — of waarom niet.
  lastReason String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  insights AgentInsight[]

  @@index([agentId])
}

enum Relevance {
  low
  medium
  high
}

/// Het resultaat van een analyse, bewaard zodat de Head het kan hergebruiken
/// zonder de agent opnieuw te laten denken.
model AgentInsight {
  id      String  @id @default(cuid())
  agentId String
  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  watchId String?
  watch   AgentWatch? @relation(fields: [watchId], references: [id], onDelete: SetNull)

  title     String
  body      String
  relevance Relevance @default(medium)

  /// Op welke stand van de data dit inzicht is gebaseerd.
  dataVersion Int @default(0)

  /// Of de Head dit al in een rapport heeft verwerkt.
  reportedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([agentId, createdAt(sort: Desc)])
  @@index([reportedAt])
}

/// Wat een agent onthoudt tussen gesprekken door.
///
/// Een inzicht (AgentInsight) is een waarneming van één moment die in het
/// rapport belandt en daarna klaar is. Een herinnering blijft: een besluit van
/// Enriqueo, een voorkeur, een vaste afspraak. Ze gaan mee in het systeemprompt,
/// zodat hij niet elke ochtend opnieuw uitleg nodig heeft.
model AgentMemory {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// besluit | voorkeur | afspraak | leerpunt | context
  kind  String @default("context")
  title String
  body  String

  /// Wie dit heeft vastgelegd: de agent zelf, of Enriqueo met de hand.
  source String @default("agent")

  /// Vastgezet blijft altijd meegaan, ook als de lijst lang wordt.
  pinned Boolean @default(false)

  /// Verlopen herinneringen blijven leesbaar in het dossier maar gaan niet
  /// meer mee in het prompt. Zo blijft zichtbaar waarom iets ooit gold.
  activeUntil DateTime?
  archivedAt  DateTime?

  /// Laatste keer dat deze herinnering in een prompt is meegegeven — laat zien
  /// wat echt gebruikt wordt en wat dode ballast is.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId, pinned, createdAt(sort: Desc)])
}

model CostEntry {
  id       String   @id @default(cuid())
  date     DateTime
  agentId  String?
  agent    Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  provider String
  model    String
  tokensIn  Int   @default(0)
  tokensOut Int   @default(0)
  costEur   Float @default(0)

  @@unique([date, agentId, provider, model])
  @@index([date])
}

model Notification {
  id      String        @id @default(cuid())
  level   ActivityLevel @default(info)
  title   String
  body    String?
  link    String?
  agentId String?
  agent   Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  /// Of deze melding ook naar Telegram is gestuurd.
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt(sort: Desc)])
}

/// Sleutel-waarde instellingen: overlegtijd, tijdzone, alertvoorkeuren,
/// Meta-credentials (versleuteld).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// Facturen en debiteuren
// ============================================================

enum InvoiceStatus {
  /// Aangemaakt, nog niet goedgekeurd.
  concept
  /// Door Enriqueo goedgekeurd, klaar om te versturen.
  goedgekeurd
  verzonden
  deels_betaald
  betaald
  /// Afgeboekt: hier komt niets meer binnen.
  oninbaar
  vervallen_verklaard
}

/// Krijgen we geld, of moeten we betalen. Beide horen in één administratie:
/// anders weet je wel wat er binnenkomt maar niet wat eruit gaat.
enum InvoiceDirection {
  uitgaand
  inkomend
}

/// Waar een factuur staat in de opvolging. Elke stap naar buiten — herinnering,
/// aanmaning, regeling — vereist het akkoord van Enriqueo; deze statussen laten
/// zien wat voorbereid is en wat werkelijk verstuurd is.
enum FollowUpStatus {
  geen
  herinnering1_voorbereid
  herinnering1_verstuurd
  herinnering2_voorbereid
  herinnering2_verstuurd
  gemeld_aan_eigenaar
  vervolgstap_voorgesteld
  /// Dossier klaargezet voor een externe partij. Gaat nooit zonder akkoord.
  escalatie_voorbereid
  escalatie_overgedragen
  afgehandeld
}

model Invoice {
  id     String @id @default(cuid())
  number String

  direction InvoiceDirection @default(uitgaand)

  /// Zodra de klant in de klantenlijst staat hangt de factuur eraan. De losse
  /// velden blijven staan: een factuur moet leesbaar blijven ook als een klant
  /// later wordt hernoemd of verwijderd.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Bij een uitgaande factuur de klant, bij een inkomende de leverancier.
  clientName    String
  clientEmail   String?
  clientAddress String?
  clientVatId   String?
  clientKvk     String?

  /// Waarvoor gefactureerd wordt, zoals het op de factuur komt te staan.
  description String?

  /// Betalingstermijn in dagen. Bewaard naast de vervaldatum, zodat je bij het
  /// aanmaken van een volgende factuur voor dezelfde klant weet wat gebruikelijk is.
  paymentTermDays Int @default(30)

  issuedOn DateTime
  dueOn    DateTime

  /// Bedrag inclusief btw, in euro. Het bedrag dat overgemaakt moet worden.
  amountEur Float
  /// Het bedrag exclusief btw en het btw-bedrag apart. Leeg wanneer er geen
  /// btw van toepassing is of het niet is opgegeven.
  netAmountEur Float?
  vatEur       Float?
  vatRate      Float?
  /// Wat er werkelijk binnen is. Leeg zolang er niets betaald is.
  paidAmountEur Float?

  status   InvoiceStatus  @default(concept)
  followUp FollowUpStatus @default(geen)

  sentAt DateTime?
  paidAt DateTime?

  /// Wanneer een herinnering daadwerkelijk is verstuurd — niet wanneer hij is
  /// voorbereid. Het verschil telt: voorbereiden mag een agent, versturen niet.
  reminder1SentAt DateTime?
  reminder2SentAt DateTime?

  notes String?

  /// Waar deze factuur vandaan komt. Nu altijd handmatig; zodra er een
  /// boekhoudpakket gekoppeld is staat hier de naam ervan en houdt externalId
  /// de koppeling vast. Zo hoeft er niets herbouwd te worden.
  source       String    @default("handmatig")
  externalId   String?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals Approval[]
  payments  IncomingPayment[]

  @@unique([source, number])
  @@index([status, dueOn])
  @@index([dueOn])
}

// ============================================================
// Onderzoek en kennis
// ============================================================

/// Wat het onderzoek betreft. Bepaalt hoe je het later terugvindt.
enum ResearchSubject {
  markt
  merk
  creator
  concurrent
  trend
  doelgroep
  prospect
  overig
}

/// Eén afgerond onderzoek, met de vraag erbij en de bronnen eronder.
///
/// Zonder dit begint elk onderzoek bij nul en wordt dezelfde vraag drie keer
/// uitgezocht. Met dit kan de Head vragen "wat weten we al over deze klant?"
/// en krijgt hij antwoord in plaats van een nieuwe zoektocht.
model ResearchEntry {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// De onderzoeksvraag zoals hij gesteld is. Hierop wordt gezocht.
  question String
  subject  ResearchSubject @default(overig)

  /// Waar het over gaat: de merknaam, de creator, de markt. Vrije tekst, want
  /// een vaste lijst zou het opzoeken juist beperken.
  about String?

  /// De belangrijkste bevindingen, in gewone taal.
  findings String
  /// Wat het betekent — de interpretatie, expliciet gescheiden van de feiten.
  insight String?
  conclusion String?
  risks         String?
  opportunities String?
  advice        String?

  /// Waar het vandaan komt. Elk item: { titel, url, geraadpleegdOp }.
  sources Json?

  /// Actuele informatie veroudert; evergreen niet. Staat hier een datum, dan
  /// weet een volgende lezer wanneer hij opnieuw moet kijken.
  staleAfter DateTime?

  /// Waar dit onderzoek bij hoorde, zodat je het vanuit een taak terugvindt.
  taskId String?

  createdAt DateTime @default(now())

  @@index([subject, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Een binnengekomen betaling die nog niet zeker aan een factuur hangt.
///
/// Een bank- of boekhoudkoppeling levert bedragen met een omschrijving; die
/// hoeven niet één op één te matchen. Kan de match niet met zekerheid gemaakt
/// worden, dan blijft de betaling hier staan tot Enriqueo hem bevestigt. Zomaar
/// koppelen zou betekenen dat een factuur op betaald staat terwijl het geld van
/// iets anders kwam — en dat merk je pas maanden later.
model IncomingPayment {
  id String @id @default(cuid())

  amountEur Float
  receivedOn DateTime
  /// Wat de bank of het boekhoudpakket meestuurde: omschrijving, tegenrekening,
  /// naam. Hierop wordt gezocht.
  reference    String?
  counterparty String?

  /// Waar deze betaling vandaan kwam: bank, boekhouding, handmatig.
  source     String  @default("handmatig")
  externalId String?

  /// De factuur waaraan hij gekoppeld is, zodra dat zeker is.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// zeker | onzeker | geen — hoe betrouwbaar de match was.
  matchConfidence String  @default("geen")
  matchReason     String?

  /// Bevestigd door Enriqueo. Zolang dit leeg is en er geen zekere match was,
  /// telt de betaling nergens in mee.
  confirmedAt DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([confirmedAt, createdAt(sort: Desc)])
}

// ============================================================
// Klanten en klantportaal
// ============================================================

/// Een klant of prospect. Eén keer vastleggen, overal gebruiken.
///
/// Bestaat los van Invoice zodat dezelfde gegevens onder meerdere facturen,
/// campagnes en briefings hangen zonder dat je ze opnieuw invoert.
model Client {
  id   String @id @default(cuid())
  name String

  contactName  String?
  email        String?
  phone        String?
  address      String?
  postalCode   String?
  city         String?
  country      String? @default("Nederland")
  kvk          String?
  vatId        String?

  /// Waar facturen heen moeten. Vaak een ander adres dan de contactpersoon.
  invoiceEmail     String?
  invoiceReference String?
  invoiceNotes     String?

  notes String?

  /// Wanneer de klant zijn gegevens voor het laatst zelf heeft aangeleverd.
  /// Leeg betekent: alles is met de hand ingevoerd.
  detailsConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  requests PortalRequest[]
  projects Project[]

  @@index([name])
}

/// Welk formulier een klant te zien krijgt. Bepaalt ook naar welke agent de
/// ingevulde gegevens gaan.
enum PortalFormType {
  klantgegevens
  campagnebriefing
  contentaanlevering
  projectinformatie
}

/// Waar een aanvraag staat. Elke stap is zichtbaar in HQ, zodat je weet of een
/// klant de link al geopend heeft of dat hij nog ergens ligt.
enum PortalStatus {
  aangemaakt
  verstuurd
  geopend
  ingevuld
  gecontroleerd
  verwerkt
  verlopen
}

/// Eén beveiligde link naar één formulier voor één klant.
///
/// De klant heeft geen account en ziet niets anders dan dit formulier. Het
/// token is de sleutel; hij is lang, willekeurig, eenmalig van doel en
/// verloopt. Verloopt of is hij verwerkt, dan geeft de pagina niets meer prijs.
model PortalRequest {
  id    String         @id @default(cuid())
  token String         @unique
  type  PortalFormType @default(klantgegevens)

  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Naam waaronder je hem aanmaakte, als de klant nog niet bestaat.
  label String?

  status PortalStatus @default(aangemaakt)

  /// Wat de klant heeft ingevuld, precies zoals hij het instuurde. Bewaard
  /// naast de verwerkte gegevens, zodat altijd terug te zien is wat er
  /// werkelijk is aangeleverd.
  submission Json?

  /// Wat er ontbrak bij het insturen. Leeg betekent compleet.
  missingFields String[] @default([])

  openedAt    DateTime?
  submittedAt DateTime?
  processedAt DateTime?
  expiresAt   DateTime

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  project Project?

  createdAt DateTime @default(now())

  @@index([status, createdAt(sort: Desc)])
}

/// Een campagne of opdracht van een klant.
///
/// Ontstaat uit een briefing en is de plek waar alles omheen hangt: wie ermee
/// bezig is, wat er ontbreekt, welke taken eruit voortkomen. Bewust licht
/// gehouden — het werk zelf staat in taken, dit is de omslag eromheen.
model Project {
  id       String  @id @default(cuid())
  name     String
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// nieuw | in_voorbereiding | loopt | afgerond | afgewezen
  status String @default("nieuw")

  /// Waar dit project vandaan komt.
  requestId String?        @unique
  request   PortalRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  /// Wat er nog ontbreekt om te kunnen starten, en bij wie het opgehaald moet
  /// worden. Zonder dit begint iemand aan werk dat later opnieuw moet.
  missingInfo String[] @default([])

  startsOn DateTime?
  endsOn   DateTime?
  deadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([status, createdAt(sort: Desc)])
}
