# Kopieer dit bestand naar .env en vul de waarden in.

# Postgres. Lokaal: start `npm run db:dev` en neem de connectiestring over die
# hij afdrukt. Productie: de connectiestring van Vercel Postgres.
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Ondertekent sessiecookies en versleutelt agent-tokens in de database.
# Genereer met: openssl rand -base64 32
APP_SECRET=""

# Basis-URL van de app — gebruikt in de reader- en webhookinstructies.
APP_URL="http://localhost:3000"

# Beveiligt /api/cron/standup tegen aanroepen van buiten.
CRON_SECRET=""

# Optioneel — samenvatting van het ochtendoverleg (fase 3).
OPENROUTER_API_KEY=""

# Optioneel — Telegram-bot waarmee jij alerts ontvangt.
TELEGRAM_ALERT_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID=""

# Optioneel — Meta Marketing API (fase 4), zie docs/meta-setup.md
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
